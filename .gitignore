# claude·codex의 로컬 작업 디렉터리는 추적하지 않는다.
# 예외: codex 마켓플레이스 매니페스트, 개발용 plugin-dev-loop 스킬 진입점과 스크립트.
/.claude/*
!/.claude/skills/
/.claude/skills/*
!/.claude/skills/plugin-dev-loop/
/.claude/skills/plugin-dev-loop/*
!/.claude/skills/plugin-dev-loop/SKILL.md
!/.claude/skills/plugin-dev-loop/scripts/
/.claude/skills/plugin-dev-loop/scripts/*
!/.claude/skills/plugin-dev-loop/scripts/plugin_dev_loop.py

/.agents/*
!/.agents/plugins/
/.agents/plugins/*
!/.agents/plugins/marketplace.json
!/.agents/skills/
/.agents/skills/*
!/.agents/skills/plugin-dev-loop/
/.agents/skills/plugin-dev-loop/*
!/.agents/skills/plugin-dev-loop/SKILL.md
!/.agents/skills/plugin-dev-loop/scripts/
/.agents/skills/plugin-dev-loop/scripts/*
!/.agents/skills/plugin-dev-loop/scripts/plugin_dev_loop.py
!/.agents/skills/plugin-dev-loop/agents/
/.agents/skills/plugin-dev-loop/agents/*
!/.agents/skills/plugin-dev-loop/agents/openai.yaml

/.skywork/
/.zvec-grep/

__pycache__/
*.pyc
